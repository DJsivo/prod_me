.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Файлы окружения
.env
.env.*

# Данные и модели, которые при необходимости отслеживаются через DVC
/data/raw/*
/data/processed/*
/models/*
!/data/raw/.gitkeep
!/data/raw/*.dvc
!/data/processed/.gitkeep
!/data/processed/*.dvc
!/models/.gitkeep
!/models/*.dvc

# Отчеты, сгенерированные ноутбуками или скриптами
/reports/*.png
/reports/*.jpg
/reports/*.jpeg
/reports/*.pdf
!/reports/screenshots/
!/reports/screenshots/*.png

# Локальные файлы инструментов
.dvc/tmp/
.dvc/cache/
